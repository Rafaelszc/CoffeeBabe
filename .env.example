# Copie para .env (não versionado) e ajuste os valores.
POSTGRES_DB=coffeebabe
POSTGRES_USER=postgres
POSTGRES_PASSWORD=troque-esta-senha
# Porta do banco exposta em 127.0.0.1 para ferramentas locais (a 5432 costuma estar em uso).
DB_HOST_PORT=5433
# Segredo do JWT (mínimo 32 bytes): gere com `openssl rand -base64 32`.
JWT_SECRET=troque-este-segredo-por-um-valor-gerado
# Admin inicial, criado na subida se o e-mail ainda não existir. Vazio = não cria.
ADMIN_EMAIL=admin@coffeebabe.local
ADMIN_PASSWORD=troque-esta-senha-de-admin
